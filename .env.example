# ─────────────────────────────────────────────────────────────────────────────
# PositivePay Converter — environment variables
# Copy to .env.local for development. In production set these in your host's
# dashboard. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash. Used for links in emails, Stripe
# redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where customers can reach you. Shown on the contact and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Legal entity name shown in the footer and legal pages (e.g. "Acme Tools LLC").
NEXT_PUBLIC_LEGAL_NAME=PositivePay Converter

# Set to "true" only after a lawyer has reviewed the legal pages. Until then they
# display a "draft" notice.
NEXT_PUBLIC_LEGAL_REVIEWED=false

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. REQUIRED in production.
# Leave unset in development to use an embedded database stored in ./.data
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── Authentication ──────────────────────────────────────────────────────────
# Random secret used to sign sessions. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated email addresses that become admins when they verify their email.
ADMIN_EMAILS=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without a key, emails are written to the server log instead of being sent.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="PositivePay Converter <hello@yourdomain.com>"
# Where contact-form messages and bank requests are forwarded (optional).
SUPPORT_INBOX=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Without these, the pricing page works but checkout explains that billing
# isn't set up yet. See BILLING.md. `npm run stripe:setup` creates the products
# and prints the price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BOOKKEEPER_MONTHLY=
# Optional. Leave empty unless you add a yearly Bookkeeper price in src/config/plans.ts.
STRIPE_PRICE_BOOKKEEPER_YEARLY=
