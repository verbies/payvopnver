{
  "name": "positive-pay-converter",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.11" },
  "scripts": {
    "layouts:index": "node scripts/build-layout-index.mjs",
    "predev": "npm run layouts:index",
    "dev": "next dev",
    "prebuild": "npm run layouts:index",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run layouts:index",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.540.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^18.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
